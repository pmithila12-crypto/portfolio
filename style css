
:root {
    --purple: #643aed;
    --dark: #1f1d95;
    --light: #ede9fe;
    --text: #302449;
    --muted: #756987;
    --white: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--white);
    color: var(--text);
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

section {
    padding: 100px 8%;
    scroll-margin-top: 70px;
}

.section-title {
    text-align: center;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--dark);
    margin-bottom: 12px;
}

.section-title span {
    color: var(--purple);
}

.subtitle {
    text-align: center;
    color: var(--muted);
    margin-bottom: 42px;
}

/* NAVIGATION */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #ffffffed;
    backdrop-filter: blur(12px);
    box-shadow: 0 3px 20px #7c3aed12;
}

nav {
    max-width: 1150px;
    margin: auto;
    padding: 15px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    color: var(--purple);
}

.logo span {
    color: var(--dark);
}

.menu-btn {
    border: none;
    background: var(--light);
    color: var(--dark);
    font-size: 25px;
    padding: 5px 12px;
    border-radius: 10px;
    cursor: pointer;
}

.nav-links {
    display: none;
    position: absolute;
    right: 22px;
    top: 70px;
    min-width: 210px;
    padding: 14px;
    background: white;
    box-shadow: 0 8px 30px #4c1d9525;
    border-radius: 16px;
}

.nav-links.active {
    display: flex;
    flex-direction: column;
}

.nav-links a {
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}

.nav-links a:hover {
    background: var(--light);
    color: var(--purple);
}

/* BUTTONS */
.btn {
    display: inline-block;
    background: var(--purple);
    color: white;
    border: 2px solid var(--purple);
    border-radius: 30px;
    padding: 12px 24px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    background: var(--dark);
    border-color: var(--dark);
    transform: translateY(-3px);
}

.btn-outline {
    background: white;
    color: var(--purple);
    margin-left: 8px;
}

/* HOME */
#home {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 125px;
    background:
        radial-gradient(circle at 10% 20%, #ede9fe 0, transparent 32%),
        radial-gradient(circle at 90% 80%, #f3e8ff 0, transparent 30%),
        white;
}

.hero {
    max-width: 1100px;
    width: 100%;
    margin: auto;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 45px;
}

.tag {
    display: inline-block;
    padding: 8px 15px;
    background: var(--light);
    color: var(--dark);
    border-radius: 30px;
    font-size: 13px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.2;
    margin-bottom: 15px;
}

.hero h1 span {
    color: var(--purple);
}

.wave-text {
    color: var(--dark);
    font-size: clamp(20px, 3vw, 30px);
    margin: 18px 0;
}

.wave-text span {
    display: inline-block;
    animation: wave 1.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.06s);
}

@keyframes wave {
    0%, 40%, 100% {
        transform: translateY(0);
    }

    20% {
        transform: translateY(-8px);
    }
}

.hero p {
    line-height: 1.9;
    color: var(--muted);
    margin-bottom: 25px;
}

/* PROFILE PHOTO */
.photo-frame {
    width: min(300px, 100%);
    aspect-ratio: 1;
    margin: auto;
    padding: 9px;
    border: 3px solid var(--purple);
    border-radius: 48% 52% 40% 60% / 45% 40% 60% 55%;
    animation: float 4s ease-in-out infinite;
    background: var(--light);
    box-shadow: 0 20px 60px #7c3aed25;
}

.photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}

/* SOCIAL ICONS */
.social-row {
    display: flex;
    gap: 13px;
    margin-top: 25px;
    align-items: center;
    flex-wrap: wrap;
}

.social-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #dfd1fa;
    border-radius: 50%;
    background: white;
    color: var(--purple);
    font-size: 19px;
    transition: 0.3s;
    box-shadow: 0 6px 18px #4c1d950b;
}

.social-icon:hover {
    background: var(--purple);
    color: white;
    transform: translateY(-5px);
}

/* SKILLS */
#skills {
    min-height: 100vh;
    padding: 110px 8% 80px;
    background: linear-gradient(135deg, #f5f0ff, #ffffff);
}

.skills-heading {
    max-width: 1000px;
    margin: 35px auto 22px;
    text-align: center;
    font-size: 23px;
    color: var(--purple);
}

.skills-grid {
    max-width: 1000px;
    margin: 0 auto 35px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}

#skills .skills-grid:nth-of-type(2) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

.skill {
    padding: 28px 15px;
    text-align: center;
    background: white;
    border: 1px solid #e3d7ff;
    border-radius: 20px;
    box-shadow: 0 8px 25px #643aed12;
    transition: all 0.3s ease;
}

.skill:hover {
    transform: translateY(-8px);
    border-color: var(--purple);
    box-shadow: 0 15px 35px #643aed25;
}

.skill > div:first-child {
    width: 65px;
    height: 65px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    background: linear-gradient(135deg, #8b5cf6, #4c1d95);
    color: white;
    font-size: 30px;
    box-shadow: 0 7px 18px #643aed30;
    transition: transform 0.3s ease;
}

.skill:hover > div:first-child {
    transform: scale(1.1);
}

.skill h3 {
    color: var(--dark);
    font-size: 17px;
    margin-bottom: 9px;
}

.skill p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
}

/* EXPERIENCE / INTERNSHIP */
#experience,
.internship-section {
    background: linear-gradient(135deg, #faf8ff, #ffffff);
}

.internship-card {
    max-width: 950px;
    margin: 30px auto;
    padding: 35px;
    background: white;
    border: 1px solid #e3d7ff;
    border-radius: 25px;
    box-shadow: 0 12px 35px #643aed15;
    transition: 0.4s ease;
}

.internship-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 18px 40px #643aed25;
}

.internship-heading {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.internship-icon {
    width: 75px;
    height: 75px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 20px;
    color: white;
    font-size: 32px;
    background: linear-gradient(135deg, #8b5cf6, #4c1d95);
}

.internship-heading h3 {
    color: var(--dark);
    font-size: clamp(20px, 3vw, 27px);
    margin-bottom: 6px;
}

.internship-heading p,
.internship-description,
.internship-step p {
    color: var(--muted);
}

.internship-heading p {
    font-size: 13px;
}

.internship-description {
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 25px;
}

.internship-timeline {
    border-left: 3px solid #c4b5fd;
    padding-left: 25px;
    margin: 25px 0;
}

.internship-step {
    position: relative;
    margin-bottom: 25px;
}

.internship-step:last-child {
    margin-bottom: 0;
}

.internship-step::before {
    content: "";
    position: absolute;
    left: -34px;
    top: 5px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #8b5cf6;
    border: 3px solid white;
    box-shadow: 0 0 0 2px #c4b5fd;
}

.internship-step h4 {
    color: var(--purple);
    font-size: 16px;
    margin-bottom: 8px;
}

.internship-step p {
    font-size: 13px;
    line-height: 1.8;
}

.internship-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0;
}

.internship-skills span {
    padding: 9px 15px;
    border-radius: 25px;
    background: var(--light);
    color: var(--purple);
    border: 1px solid #ddd0ff;
    font-size: 12px;
    font-weight: 600;
    transition: 0.3s;
}

.internship-skills span:hover {
    background: var(--purple);
    color: white;
    transform: translateY(-3px);
}

/* PROJECTS */
#projects {
    background: white;
}

.project-card {
    position: relative;
    overflow: hidden;
    max-width: 950px;
    margin: 25px auto;
    padding: 30px;
    text-align: center;
    border-radius: 25px;
    background: linear-gradient(145deg, #ffffff, #f1eaff);
    border: 2px solid #e3d7ff;
    box-shadow: 0 10px 30px #6a3cdc1f;
    transition: all 0.4s ease;
}

.project-card::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    top: -80px;
    right: -70px;
    background: radial-gradient(circle, #b99aff80, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}

.project-card:hover {
    transform: translateY(-8px);
    border-color: #8b5cf6;
    box-shadow: 0 20px 45px #6a3cdc40;
}

.project-icon {
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
    border-radius: 25px;
    background: linear-gradient(135deg, #8b5cf6, #5b21b6);
    box-shadow: 0 10px 25px #8b5cf655;
}

.project-icon i {
    font-size: 45px;
    color: white;
}

.dice-icon {
    font-size: 60px;
    margin-bottom: 12px;
}

.project-card h3 {
    color: #5521a8;
    font-size: 25px;
    font-weight: 800;
    margin-bottom: 15px;
    position: relative;
}

.project-card p {
    color: #51466a;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 12px;
    position: relative;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 22px 0;
}

.project-tags span {
    padding: 8px 15px;
    border-radius: 30px;
    background: #ede5ff;
    color: #6426c5;
    border: 1px solid #d6c5ff;
    font-size: 12px;
    font-weight: 700;
}

.project-btn {
    display: inline-block;
    padding: 12px 25px;
    margin-top: 10px;
    border-radius: 30px;
    background: linear-gradient(135deg, #8b5cf6, #5b21b6);
    color: white;
    font-weight: 700;
}

/* DICE GAME */
.dice-game {
    margin-top: 25px;
    padding: 22px;
    background: var(--light);
    border-radius: 16px;
}

.dice-result {
    font-size: 70px;
    margin: 10px;
    min-height: 88px;
}

.roll-message {
    min-height: 28px;
    color: var(--dark) !important;
    font-weight: 600;
    margin-bottom: 12px !important;
}

/* CONTACT */
.contact-wrap {
    max-width: 900px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
}

.contact-intro {
    padding: 28px;
    border-radius: 20px;
    background: #faf8ff;
    border: 1px solid #eee5ff;
}

.contact-intro h3 {
    font-size: 25px;
    color: var(--dark);
    margin-bottom: 12px;
}

.contact-intro p {
    line-height: 1.9;
    color: var(--muted);
}

.contact-links {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin-top: 22px;
}

.contact-link {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--dark);
    font-weight: 500;
    overflow-wrap: anywhere;
}

.contact-link i {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--light);
    color: var(--purple);
    font-size: 17px;
    flex-shrink: 0;
}

/* CLOSING MESSAGE */
.closing {
    margin: 55px auto 0;
    max-width: 900px;
    text-align: center;
    padding: 35px 20px;
    background: linear-gradient(135deg, #f5f3ff, #ede9fe);
    border-radius: 22px;
}

.closing h3 {
    font-size: clamp(25px, 4vw, 38px);
    color: var(--dark);
    margin-bottom: 10px;
}

.closing p {
    color: var(--muted);
    margin-bottom: 18px;
}

/* FOOTER */
footer {
    padding: 24px;
    text-align: center;
    color: white;
    background: var(--dark);
    font-size: 13px;
}

/* SCROLL ANIMATIONS */
.reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s, transform 0.7s;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

/* CUSTOM CURSOR */
.cursor-dot {
    position: fixed;
    width: 10px;
    height: 10px;
    background: var(--purple);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2000;
    transform: translate(-50%, -50%);
    display: none;
}

@media (pointer: fine) {
    .cursor-dot {
        display: block;
    }
}

/* TABLET */
@media (max-width: 768px) {
    section {
        padding: 85px 6%;
    }

    .hero {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 30px;
    }

    .photo-frame {
        width: 220px;
        grid-row: 1;
    }

    .social-row {
        justify-content: center;
    }

    .skills-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #skills .skills-grid:nth-of-type(2) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .btn-outline {
        margin: 12px 0 0;
    }

    .internship-card {
        padding: 25px;
    }

    .cursor-dot {
        display: none;
    }
}

/* MOBILE */
@media (max-width: 420px) {
    .section-title {
        font-size: 29px;
    }

    .skills-grid,
    #skills .skills-grid:nth-of-type(2) {
        grid-template-columns: 1fr;
    }

    .skills-heading {
        font-size: 20px;
    }

    .skill {
        padding: 24px 18px;
    }

    .hero .btn {
        margin: 5px 0;
    }

    .social-icon {
        width: 41px;
        height: 41px;
    }

    .project-card {
        padding: 24px 18px;
    }

    .project-card h3 {
        font-size: 22px;
    }

    .internship-card {
        padding: 23px 18px;
    }

    .internship-heading {
        align-items: flex-start;
        gap: 13px;
    }

    .internship-icon {
        width: 58px;
        height: 58px;
        font-size: 25px;
    }
}

/* ACCESSIBILITY */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }
}
